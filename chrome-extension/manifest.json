{
  "manifest_version": 3,
  "name": "CivitaiFreeTool 一键下载",
  "version": "2.1.0",
  "description": "模型页一键下载/批量标签页提交到 CivitaiFreeTool；一键归档（封面/配图/评论/模型信息）到本地归档目录，软件离线时降级为浏览器下载",
  "permissions": [
    "tabs",
    "contextMenus",
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://civitai.red/*",
    "https://civitai.com/*",
    "https://www.civitai.red/*",
    "https://www.civitai.com/*",
    "https://image.civitai.com/*",
    "https://delivery.civitai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/models/*",
        "https://www.civitai.com/models/*",
        "https://civitai.red/models/*",
        "https://www.civitai.red/models/*"
      ],
      "js": ["lib/util.js", "content/model-page.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://civitai.com/images/*",
        "https://www.civitai.com/images/*",
        "https://civitai.red/images/*",
        "https://www.civitai.red/images/*",
        "https://civitai.com/posts/*",
        "https://www.civitai.com/posts/*",
        "https://civitai.red/posts/*",
        "https://www.civitai.red/posts/*"
      ],
      "js": ["lib/util.js", "lib/idb.js", "content/image-badge.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CivitaiFreeTool 一键下载",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}