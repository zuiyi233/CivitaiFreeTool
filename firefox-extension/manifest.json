{
  "manifest_version": 3,
  "name": "CivitaiFreeTool 一键下载",
  "version": "1.8.0",
  "description": "筛选全部浏览器窗口的 C 站模型标签页，用公开接口补全类型/底模/大小，批量提交到 CivitaiFreeTool 并跟踪软件里的下载状态",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://civitai.red/*",
    "https://civitai.com/*",
    "https://www.civitai.red/*",
    "https://www.civitai.com/*"
  ],
  "background": {
    "scripts": [
      "tabs-common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "CivitaiFreeTool 一键下载",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "civitai-free-tool@advicesama.github.io",
      "strict_min_version": "121.0"
    }
  }
}
